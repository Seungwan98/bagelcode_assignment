# App mode
AGENTBOARD_MODE=mock

# Firebase Web SDK config (safe to expose to browser, but do not hardcode in source)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional Firebase Admin / server-only config
# Do not expose these with NEXT_PUBLIC_ prefixes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional real AI CLI adapter commands
AGENTBOARD_CODEX_CMD=codex
AGENTBOARD_CLAUDE_CMD=claude
AGENTBOARD_GEMINI_CMD=gemini
